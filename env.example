# Supabase (servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_publicable
SUPABASE_SERVICE_ROLE_KEY=tu_clave_de_servicio

# Firebase Admin (servidor)
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Authentication (servidor)
FIREBASE_WEB_API_KEY=tu_api_key_web

# Firebase Authentication (cliente, seguro de exponer).
# Si omites estos valores, la app usa FIREBASE_WEB_API_KEY + FIREBASE_PROJECT_ID
# para construir la configuración mínima del inicio con Google.
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_web
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id_web
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# URL base de la app para enlaces de verificación de correo
# Desarrollo: http://localhost:3000
# Producción: http://fiscalix.novasoftsl.com
APP_URL=http://localhost:3000

# Stripe Checkout (solo claves de prueba para el proyecto académico)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publicable
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta

# Gemini API (solo servidor). El análisis financiero se solicita manualmente desde Reportes.
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-flash-latest

# Tipos de cambio informativos para mostrar importes en otras divisas.
# La base contable de Fiscalix sigue siendo MXN.
NEXT_PUBLIC_FISCALIX_USD_MXN_RATE=18.50
NEXT_PUBLIC_FISCALIX_EUR_MXN_RATE=20.10

# Gmail API para Centro de aclaraciones (servidor)
# Genera el refresh token con estos scopes:
# https://www.googleapis.com/auth/gmail.readonly
# https://www.googleapis.com/auth/gmail.send
GMAIL_SUPPORT_EMAIL=solutionsnovasoftteam@gmail.com
GMAIL_SUPPORT_QUERY="in:inbox -category:promotions -category:social"
GMAIL_OAUTH_CLIENT_ID=tu_oauth_client_id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=tu_oauth_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=tu_refresh_token_de_gmail

# Secreto para que el VPS ejecute tareas automáticas de aclaraciones.
# Usa un valor largo y difícil de adivinar en producción.
SUPPORT_CRON_SECRET=tu_secreto_para_cron
